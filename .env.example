# Copy to .env and fill in only what you need. Never commit .env.
# Everything defaults to the offline simulated backend + mock LLM.

# --- tools -------------------------------------------------------------------
ONCALL_BACKEND=simulated            # simulated | gcp
ONCALL_SCENARIO=bad-deploy
ONCALL_ALLOWED_PROJECTS=demo-project-123   # comma-separated; set to YOUR_PROJECT_ID for gcp
ONCALL_ALLOW_WRITES=false           # gcp backend: enable the approval-gated rollback tool
ONCALL_APPROVAL_SECRET=             # shared HMAC secret when the MCP server runs in another process

# --- LLM ---------------------------------------------------------------------
ONCALL_LLM_PROVIDER=mock            # mock | mock-injectable | gemini | vertex | anthropic | openai
ONCALL_LLM_MODEL=
ONCALL_GCP_PROJECT=                 # Vertex AI project (uses ADC, no key)
ONCALL_GCP_LOCATION=global
GOOGLE_API_KEY=                     # Gemini via AI Studio (alternative to Vertex)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- budgets -----------------------------------------------------------------
ONCALL_MAX_STEPS=10
ONCALL_MAX_TOOL_CALLS=16
ONCALL_MAX_TOTAL_TOKENS=250000
ONCALL_MAX_COST_USD=1.0
ONCALL_PRICE_INPUT_PER_MTOK=0       # set to your model's price to track cost
ONCALL_PRICE_OUTPUT_PER_MTOK=0

# --- API ---------------------------------------------------------------------
ONCALL_WEBHOOK_TOKEN=               # required with the gcp backend
ONCALL_PUBSUB_AUDIENCE=             # enables OIDC verification of Pub/Sub push
ONCALL_CORS_ORIGINS=http://localhost:5173

# --- telemetry ---------------------------------------------------------------
ONCALL_OTEL_CONSOLE=false
OTEL_EXPORTER_OTLP_ENDPOINT=
